[Unit]
Description=Thirp Runtime public web ingress (Caller adapter)
Documentation=file:///usr/share/doc/thirp/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thirp
Group=thirp
ExecStart=/usr/local/bin/thirp-web-ingress --config /etc/thirp/web-ingress.conf
Restart=on-failure
RestartSec=2
LimitNOFILE=8256
# Needed only when listen is :443. An operator-chosen fronting port does not need this.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/thirp

[Install]
WantedBy=multi-user.target
