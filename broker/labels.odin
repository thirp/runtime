LABEL_LEASE_EXPIRED :: "authorization_lease_expired"

LABEL_STREAMS_PER_SESSION :: "streams_per_session"
LABEL_REGISTRATIONS_PER_SESSION :: "registrations_per_session"
LABEL_PHYSICAL_CONNECTIONS :: "physical_connections"
LABEL_CONNECTIONS_PER_IP :: "connections_per_ip"
