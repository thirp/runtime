package broker

// Log event names. One declaration; call sites use these names.

LOG_EVENT_ACCEPT_FAILED :: "accept_failed"
LOG_EVENT_AUTH_FAILED :: "auth_failed"
LOG_EVENT_CONNECT_FAILED :: "connect_failed"
LOG_EVENT_CONNECT_OK :: "connect_ok"
LOG_EVENT_DRAIN_COMPLETE :: "drain_complete"
LOG_EVENT_DRAIN_STARTED :: "drain_started"
LOG_EVENT_LIMIT_EXCEEDED :: "limit_exceeded"
LOG_EVENT_PROTOCOL_ERROR :: "protocol_error"
LOG_EVENT_REGISTER_FAILED :: "register_failed"
LOG_EVENT_ROLE_VIOLATION :: "role_violation"
LOG_EVENT_SERVICE_REGISTERED :: "service_registered"
LOG_EVENT_SERVICE_UNREGISTERED :: "service_unregistered"
LOG_EVENT_SESSION_AUTHENTICATED :: "session_authenticated"
LOG_EVENT_SESSION_CLOSED :: "session_closed"
LOG_EVENT_STREAM_RESET :: "stream_reset"
LOG_EVENT_UNREGISTER_FAILED :: "unregister_failed"

